    "import sys, pathlib\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Repository-wide SciencePlots figure style (../plotstyle.py): REVTeX geometry,\n",
    "# Computer Modern at 10 pt, outward ticks.  Everything else about this figure is\n",
    "# set in the knob block below.\n",
    "sys.path.insert(0, str(pathlib.Path.cwd().parents[1]))   # repo root: ../../plotstyle.py\n",
    "from plotstyle import TEXT_WIDTH, figsize, limit_ticks, use_style\n",
    "\n",
    "use_style()          # use_style(latex=False) → same look without a LaTeX install\n",
    "\n",
    "# ── 1. dt convergence of the collective-BTC QFI, at fixed N ──────────────────\n",
    "# The runs come from the cluster campaign, one folder per time step:\n",
    "# `<SC_ROOT>/dt_<factor>/sc_diffusive_N<N>.npz`, where the *factor* is the\n",
    "# dimensionless `Ω dt` (the runner uses dt = factor/max(Ω,κ), so every N is\n",
    "# integrated at the same fraction of a drive period).  The tree is scanned and\n",
    "# whatever is present gets plotted, so the figure stays correct as more runs\n",
    "# land — currently every factor at N=256, 512 and three of them at N=128.\n",
    "#\n",
    "# One panel per N, each overlaying the *full dynamics* for every available\n",
    "# factor, against the exact monitored-QFI reference (black dashed) at the same N.\n",
    "# Reading it: where the curves of successive factors collapse onto each other,\n",
    "# the integration is converged in dt over the whole trajectory — not just at a\n",
    "# single read-out time — and what is left between them is Monte-Carlo noise (the\n",
    "# shaded ±1σ band), not discretisation error.  The residual gap to the exact\n",
    "# curve at late κt is the semiclassical (DTWA) error itself, which no dt refines\n",
    "# away and which grows with N — hence one panel per N.\n",
    "#\n",
    "# Missing (N, Ω dt) combinations are listed on stdout below.  To fill one in,\n",
    "# e.g. N=128 at Ω dt = 0.0025, keeping this campaign's seed / batch size:\n",
    "#   python3 sc_run_batches.py 128 --n-traj 10000 \\\n",
    "#       --batch-size 25 --master-seed 67 --dt-factor 0.0025 --n-store 200 \\\n",
    "#       --outdir semiclassical_qfi_powersums_ratio_2/dt_0025\n",
    "#   python3 sc_aggregate.py \\\n",
    "#       --dir semiclassical_qfi_powersums_ratio_2/dt_0025\n",
    "\n",
    "# ═══ Figure knobs — everything about this figure is set right here ═══════════\n",
    "SC_ROOT  = Path.cwd() / \"semiclassical_qfi_powersums_ratio_2\"  # qfi = F_Q/S²\n",
    "DET_DIR  = Path.cwd() / \"deterministic_qfi\"   # qfi = bare F_Q; None → no exact\n",
    "SAVEPATH = Path.cwd() / \"dt_convergence_qfi_btc.pdf\"  # None → don't write\n",
    "\n",
    "N_PANELS = [128, 256, 512]      # one panel per N, in this order\n",
    "AS_RATE  = True                 # True → F_Q/(S² t), the sensor rate used elsewhere\n",
    "                                # in this notebook; False → accumulated F_Q/S²\n",
    "KT_LIM   = (0.5, 100.0)         # time window shown; 0.5 = first stored t>0 (κ=1, so\n",
    "                                # the stored time axis is already κt)\n",
    "YLIM     = (0.0, 5.0)           # None → autoscale\n",
    "N_YTICKS = 4                    # y tick-label budget (limit_ticks caps, never exceeds)\n",
    "LOG_X    = True                 # log time axis: the dt spread sits at early-to-mid κt\n",
    "\n",
    "SHOW_BANDS = True               # ±1σ Monte-Carlo band around each semiclassical curve\n",
    "LW         = 1.0\n",
    "CMAP       = plt.cm.viridis     # sequential + CVD-safe, for the ordered quantity dt\n",
    "CMAP_SPAN  = (0.0, 0.85)        # keep off the pale yellow end\n",
    "DET_STYLE  = dict(color=\"k\", ls=\"--\", lw=1.0)   # exact reference, as in the N-figure\n",
    "DET_LABEL  = \"Exact\"\n",
    "\n",
    "RIGHT_STRIP   = 0.16    # fraction of the canvas width reserved for the shared legend\n",
    "LEGEND_TOP    = 0.97    # top of the Ω dt colour key, in figure fractions\n",
    "LEGEND_BOTTOM = 0.14    # bottom of the exact-reference key below it\n",
    "W_PAD, H_PAD  = 0.4, 0.0  # gaps between panels, in font-size units\n",
    "PANEL_TAGS    = [\"(a)\", \"(b)\", \"(c)\"]\n",
    "PANEL_TAG_XY  = (0.03, 0.97)    # tag position in axes fractions\n",
    "N_TAG_XY      = (0.97, 0.03)    # per-panel \"N = ...\" position\n",
    "YLABEL        = r\"$I_\\Omega (t)\\,/\\,(S^2 t)$\" if AS_RATE else r\"$I_\\Omega (t)\\,/\\,S^2$\"\n",
    "LEGEND_TITLE  = r\"$\\Omega\\,\\mathrm{d}t$\"\n",
    "FIGSIZE       = figsize(TEXT_WIDTH, ratio=0.95, cols=3, rows=1)   # a figure* row\n",
    "\n",
    "\n",
    "def _load_by_N_dt(root):\n",
    "    \"\"\"{N: {Ω dt: npz-dict}} over every finished run under `root/dt_*/`.\n",
    "\n",
    "    The dimensionless step is read from the file itself (`dt·Ω`) rather than from\n",
    "    the folder name, so a mislabelled folder cannot silently shift a curve.\n",
    "    \"\"\"\n",
    "    out = {}\n",
    "    for f in sorted(root.glob(\"dt_*/sc_diffusive_N*.npz\")):\n",
    "        if \".ckpt.\" in f.name:                     # skip in-progress checkpoints\n",
    "            continue\n",
    "        d = np.load(f)\n",
    "        if \"N\" not in d.files:                     # not a finished result -> skip\n",
    "            continue\n",
    "        factor = float(d[\"dt\"]) * float(d[\"Omega\"])\n",
    "        out.setdefault(int(d[\"N\"]), {})[factor] = {k: d[k] for k in d.files}\n",
    "    return {N: dict(sorted(v.items(), reverse=True)) for N, v in sorted(out.items())}\n",
    "\n",
    "\n",
    "def _load_det(directory):\n",
    "    \"\"\"{N: npz-dict} for the deterministic (exact) reference runs.\"\"\"\n",
    "    out = {}\n",
    "    for f in sorted(directory.glob(\"det_N*.npz\")) if directory else []:\n",
    "        if \".ckpt.\" in f.name:                     # skip in-progress checkpoints\n",
    "            continue\n",
    "        d = np.load(f)\n",
    "        if \"N\" in d.files:\n",
    "            out[int(d[\"N\"])] = {k: d[k] for k in d.files}\n",
    "    return dict(sorted(out.items()))\n",
    "\n",
    "\n",
    "def _curve(d, per_S2=False):\n",
    "    \"\"\"(t, y, err) at t>0 — the QFI rate F_Q/(S² t) or the accumulated F_Q/S².\n",
    "\n",
    "    `per_S2` divides by S², for the deterministic files that store the *bare* F_Q\n",
    "    (the semiclassical ones already return F_Q/S²).\n",
    "    \"\"\"\n",
    "    t = np.asarray(d[\"times\"], dtype=float)\n",
    "    m = t > 0                                      # rate undefined at t=0\n",
    "    norm = (t[m] if AS_RATE else 1.0) * (float(d[\"S\"]) ** 2 if per_S2 else 1.0)\n",
    "    return t[m], d[\"qfi\"][m] / norm, d[\"qfi_stderr\"][m] / norm\n",
    "\n",
    "\n",
    "runs = _load_by_N_dt(SC_ROOT) if SC_ROOT.exists() else {}\n",
    "det  = _load_det(DET_DIR)\n",
    "if not runs:\n",
    "    print(f\"no semiclassical data yet in {SC_ROOT} — plotting the exact reference only\")\n",
    "# One colour per time step, assigned once and shared by all panels, so a given\n",
    "# Ω dt keeps its colour everywhere — including where a run is still missing.\n",
    "factors  = sorted({f for N in N_PANELS for f in runs.get(N, {})}, reverse=True)\n",
    "color_of = {f: c for f, c in zip(factors, CMAP(np.linspace(*CMAP_SPAN, len(factors))))}\n",
    "for N in N_PANELS:\n",
    "    have    = sorted(runs.get(N, {}), reverse=True)\n",
    "    missing = [f for f in factors if f not in have]\n",
    "    print(f\"N={N:4d}: Ω dt = {[f'{f:g}' for f in have]}\"\n",
    "          + (f\"   missing: {[f'{f:g}' for f in missing]}\" if missing else \"\")\n",
    "          + (\"   [no exact reference]\" if N not in det else \"\"))\n",
    "\n",
    "fig, axes = plt.subplots(1, len(N_PANELS), figsize=FIGSIZE, sharex=True, sharey=True)\n",
    "\n",
    "for ax, tag, N in zip(np.atleast_1d(axes), PANEL_TAGS, N_PANELS):\n",
    "    for factor, d in runs.get(N, {}).items():      # coarsest first -> finest on top\n",
    "        t, y, e = _curve(d)\n",
    "        c = color_of[factor]\n",
    "        ax.plot(t, y, color=c, lw=LW, zorder=3)\n",
    "        if SHOW_BANDS:\n",
    "            ax.fill_between(t, y - e, y + e, color=c, alpha=0.20, lw=0, zorder=2)\n",
    "    if N in det:                                   # exact monitored QFI at this N\n",
    "        t, y, _ = _curve(det[N], per_S2=True)\n",
    "        ax.plot(t, y, zorder=4, **DET_STYLE)\n",
    "    if LOG_X:\n",
    "        ax.set_xscale(\"log\")\n",
    "    ax.set_xlim(*KT_LIM)\n",
    "    if YLIM:\n",
    "        ax.set_ylim(*YLIM)\n",
    "    ax.set_xlabel(r\"$\\kappa t$\")\n",
    "    ax.text(*PANEL_TAG_XY, tag, transform=ax.transAxes, ha=\"left\", va=\"top\")\n",
    "    ax.text(*N_TAG_XY, rf\"$N = {N}$\", transform=ax.transAxes, ha=\"right\", va=\"bottom\")\n",
    "    limit_ticks(ax, N_YTICKS, axis=\"y\")\n",
    "\n",
    "axes[0].set_ylabel(YLABEL)                         # left panel carries the y label\n",
    "for ax in axes[1:]:                                # shared scale -> ticks but no labels\n",
    "    ax.tick_params(axis=\"y\", which=\"both\", left=True, labelleft=False)\n",
    "\n",
    "# One key for the whole figure, to the right of the panels: the dt colour ladder\n",
    "# on top, the exact reference below it (its black dashed line means the same in\n",
    "# every panel, so it does not belong inside the Ω dt block).  The strip is\n",
    "# reserved *inside* the canvas: the figure is saved with a standard bbox (to keep\n",
    "# the exact text width), so anything placed outside the canvas would be cut off.\n",
    "fig.tight_layout(rect=(0, 0, 1 - RIGHT_STRIP, 1), w_pad=W_PAD, h_pad=H_PAD)\n",
    "LEGEND_KW = dict(frameon=False, handlelength=1.0, borderaxespad=0.0, borderpad=0.0)\n",
    "if factors:                     # no semiclassical runs yet -> no dt colour key\n",
    "    fig.legend(handles=[plt.Line2D([], [], color=color_of[f], lw=1.4, label=rf\"${f:g}$\")\n",
    "                        for f in factors],\n",
    "               title=LEGEND_TITLE, loc=\"upper left\",\n",
    "               bbox_to_anchor=(1 - RIGHT_STRIP, LEGEND_TOP), **LEGEND_KW)\n",
    "if det:\n",
    "    fig.legend(handles=[plt.Line2D([], [], label=DET_LABEL, **DET_STYLE)],\n",
    "               loc=\"lower left\", bbox_to_anchor=(1 - RIGHT_STRIP, LEGEND_BOTTOM),\n",
    "               **LEGEND_KW)\n",
    "\n",
    "if SAVEPATH:\n",
    "    fig.savefig(SAVEPATH)   # no bbox_inches=\"tight\": that would crop the canvas\n",
    "plt.show()\n"
   ]
